separator_block_width=15
markup=pango

[window]
command=xprop -id $(xprop -root 32x '\t$0' _NET_ACTIVE_WINDOW | cut -f2) WM_NAME 2>/dev/null | cut -d '"' -f2
interval=2
color=#a6adc8
align=left

[caffeine]
command=~/.config/i3/caffeine-block.sh
interval=5
color=#585b70
min_width=30
align=center

[media_prev]
command=~/.config/i3/media-prev.sh
interval=once
signal=11
color=#a6adc8
separator=false

[media_pp]
command=~/.config/i3/media-pp.sh
interval=once
signal=11
color=#a6adc8
separator=false

[media_next]
command=~/.config/i3/media-next.sh
interval=once
signal=11
color=#a6adc8
separator=false

[volume]
command=~/.config/i3/volume-block.sh
interval=once
signal=10
color=#a6adc8
separator_block_width=15

[brightness]
command=~/.config/i3/brightness-block.sh
interval=5
color=#a6adc8

[vpn]
command=~/.config/i3/vpn-block.sh
interval=10
color=#6c7086

[power]
command=~/.config/i3/power-block.sh
interval=10
color=#585b70

[battery]
command=~/.config/i3/battery-block.sh
interval=30
color=#a6adc8

[date]
command=date '+%H:%M on %a %d/%m'
interval=5
color=#7f849c
